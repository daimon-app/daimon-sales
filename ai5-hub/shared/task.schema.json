{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.ai5/schemas/task.schema.json",
  "title": "AI5 Zero Command Task v6",
  "type": "object",
  "required": ["task_id","project_id","product_id","objective","assigned_ai","support_ai","writer","priority","source_commit","expected_output","acceptance_criteria","status","retry_count","max_attempts","parent_task","created_at","updated_at"],
  "properties": {
    "task_id": {"type":"string","minLength":1},
    "project_id": {"type":"string"},
    "product_id": {"type":"string"},
    "objective": {"type":"string","minLength":1},
    "assigned_ai": {"enum":["zero","manus","claude","gemini","codex"]},
    "support_ai": {"type":"array","items":{"enum":["zero","manus","claude","gemini","codex"]},"uniqueItems":true},
    "writer": {"enum":["NONE","manus","claude","gemini","codex"]},
    "priority": {"enum":["low","normal","high","critical"]},
    "source_commit": {"type":"string"},
    "expected_output": {"type":"string"},
    "acceptance_criteria": {"type":"array","items":{"type":"string"}},
    "status": {"enum":["queued","planning","waiting_approval","running","reviewing","completed","failed","cancelled","blocked"]},
    "retry_count": {"type":"integer","minimum":0},
    "max_attempts": {"type":"integer","minimum":1,"maximum":10},
    "parent_task": {"type":["string","null"]},
    "created_at": {"type":"string","format":"date-time"},
    "updated_at": {"type":"string","format":"date-time"}
  },
  "additionalProperties": true
}
