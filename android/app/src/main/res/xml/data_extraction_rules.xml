<?xml version="1.0" encoding="utf-8"?>
<!-- No backup/transfer of app data: mirrors android:allowBackup="false". -->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapability="false">
        <exclude domain="root" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
    </device-transfer>
</data-extraction-rules>
