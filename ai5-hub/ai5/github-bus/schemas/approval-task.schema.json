{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI5 HUB Approval Task",
  "type": "object",
  "required": ["schema_version","type","task_id","project","action","why","exact_scope","visibility","cost","reversible","risk","what_changes","what_does_not_change","priority","approve_button","reject_button","scope_hash","global_state","blocked_scope","created_at"],
  "properties": {
    "schema_version": {"const":"2026-09-01.1"},
    "type": {"const":"AI5_HUB_APPROVAL_TASK"},
    "task_id": {"type":"string","minLength":3},
    "project": {"type":"string"},
    "action": {"type":"string","minLength":1},
    "why": {"type":"string","minLength":1},
    "exact_scope": {"type":"object"},
    "visibility": {"enum":["PUBLIC","PRIVATE"]},
    "cost": {"type":"string","minLength":1},
    "reversible": {"type":"boolean"},
    "risk": {"enum":["LOW","MEDIUM","HIGH"]},
    "what_changes": {"type":"string"},
    "what_does_not_change": {"type":"array","items":{"type":"string"}},
    "priority": {"enum":["P0","P1","P2"]},
    "owner_action_required": {"type":"boolean"},
    "owner_action": {"type":["string","null"]},
    "after_approval": {"type":"string"},
    "approve_button": {"const":"APPROVE"},
    "reject_button": {"const":"REJECT"},
    "expires_at": {"type":["string","null"],"format":"date-time"},
    "scope_hash": {"type":"string","minLength":1},
    "idempotency_key": {"type":"string"},
    "global_state": {"const":"EXECUTING"},
    "blocked_scope": {"const":"THIS_TASK_ONLY"},
    "created_at": {"type":"string","format":"date-time"}
  },
  "additionalProperties": false
}
