<?xml version="1.0" encoding="utf-8"?>
<!--
  Product WebView traffic remains deny-by-default even though Play Billing requires INTERNET:
  future dependency requests network access, no cleartext traffic is permitted
  and no domain is trusted for plaintext connections.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
